# Base URL of the Shunn Labs auth service (Shuun_Auth_Server).
# Local development default:
VITE_AUTH_API_URL=http://localhost:8001

# Production: set this in Vercel (Settings -> Environment Variables), NOT
# here -- this file is gitignored and never reaches the build.
#
# Vite inlines the value at BUILD time, so changing it in Vercel requires a
# redeploy to take effect. If it is unset the bundle falls back to the
# localhost default below, which is why a deployed signup page tries to
# call http://localhost:8001.
#
# VITE_AUTH_API_URL=https://auth.shuun.site
