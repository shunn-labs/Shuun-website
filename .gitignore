# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files. `*.local` above only covers .env.local, so name the
# rest explicitly — the template is the only one that belongs in git.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Added by the Vercel CLI.
.vercel

# The CLI also appended a bare `.env*` here, which re-ignored the template
# because a later rule wins. The explicit rules above already cover every
# .env file; keep the negation last so .env.example stays committable.
.env*
!.env.example
